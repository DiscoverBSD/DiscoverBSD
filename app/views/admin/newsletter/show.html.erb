<div class="section">
  <div class="container">
    <div class="message">
      <div class="message-body">
        The newest article from: <%= @newest %>. The oldest from: <%= @oldest %>.
        <a href="<%= root_path %>" class="button is-dark is-pulled-right">Back to web</a>
      </div>
    </div>
  </div>
  <div class="container" >
    <div class="control">
      <textarea rows="30"
        class="textarea is-focused" readonly
      >
       <%= @code %>
      </textarea>
    </div>
  </div>
</div>
