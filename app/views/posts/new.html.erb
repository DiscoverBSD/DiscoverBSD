<div class="container">
  <% if logged_in? %>
    <div data-controller="gen">
      <h1 class="title is-4">Submit new post</h1>
      <%= form_for @post, data: {controller: "submit", submit_target: "form"} do |f| %>
        <%= f.hidden_field :author_id, value: current_user.id %>
        
        <div class="field is-grouped">
          <label class="label">Url</label>
          <div class="control is-expanded">
            <%= f.text_field :url, class: 'input', placeholder: "ie. https://example.com/make-your-bsd-awesome", 
            data: { gen_target: "url"} %>
          </div>
          <p class="control">
            <button class="button is-dark"  data-action="click->gen#generate" data-gen-target="button">
              <span class="icon">
                <i class="fas fa-magic"></i>
              </span>
              <span>Generate from URL</span>
            </button>          
          </p>
        </div>
        <div>
          <p class="help is-right" data-gen-target="message"></p>
        </div>
        
        <div class="field">
          <label class="label">Title</label>
          <div class="control">
            <%= f.text_field :title, class: 'input', placeholder: "ie. How to make your BSD awesome", 
            data: { gen_target: "title"} %>
          </div>
        </div>

        <div class="field">
          <label class="label">Description</label>
          <div class="control">
            <%= f.text_area :description, class: 'textarea', placeholder: "ie. In this article, Mr. Awesome talks about how to make any BSD shine like a sun. Learn the tips to create awesome scripts and securing your **grandma**'s BSD. \r\n\r\nUsage of basic markdown is allowed.", 
            data: { gen_target: "description"} %>
          </div>
        </div>

        <div class="field is-grouped is-grouped-right">
          <div class="control">
            <%= f.submit "Submit", class:"button is-dark", data: {action: "click->submit#submit", submit_target: "button"} %>
          </div>
        </div>

        <div>
          <p class="help" data-submit-target="error"></p>
        </div>
      <% end %>
      <%= form_with url: home_gen_path, data: {gen_target: 'form'} do |form| %>
        <%= form.text_field :url, data: {gen_target: 'suburl'}, class: 'is-invisible' %>
      <% end %>
    </div>
  <% else %>
    <article class="message is-dark is-medium">
      <div class="message-body">
        <p>
          As you are not logged in, you will be redirected via Github to signup or sign in.
          You will be able to add your post then.
        </p>
        <div data-controller="terms">
          <div class="buttons is-centered">
            <form method="post" action="/auth/github" class="has-text-centered">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <button type="submit" class="button is-dark" data-terms-target="auth">Authenticate with Github</button>
            </form>
          </div>
          <p>
            <label class="checkbox is-size-6 has-text-right">
              <input type="checkbox" data-terms-target="checkbox" data-action="terms#setDisabled">
              I agree to the <a href="https://github.com/DiscoverBSD/DiscoverBSD/blob/master/TERMS.md" target="_blank">Terms and Conditions</a> and <a href="https://github.com/DiscoverBSD/DiscoverBSD/blob/master/PRIVACY.md" target="_blank">Privacy Policy</a>.
            </label>
          </p>
        </div>
      </div>
    </article>
  <% end %>
</div>
